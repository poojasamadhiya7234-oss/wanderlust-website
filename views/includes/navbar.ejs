<!-- ========================================= -->
<!-- NAVBAR CSS -->
<!-- ========================================= -->

<style>

  /* ============================= */
  /* NAVBAR MAIN */
  /* ============================= */

  .navbar {
    min-height: 70px;
  }


  /* ============================= */
  /* LOGO */
  /* ============================= */

  .navbar-brand {
    font-size: 28px;
    color: #ff385c;
    margin-right: 25px;
  }

  .navbar-brand:hover {
    color: #e31c5f;
  }


  /* ============================= */
  /* SEARCH AREA */
  /* ============================= */

  .navbar-search-area {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    flex: 1;
  }


  /* Search input container */

  .nav-search {
    display: flex;
    align-items: center;
    background: white;
    border: 1px solid #ddd;
    border-radius: 30px;
    height: 44px;
    width: 230px;
    margin-left: 0;
    overflow: hidden;
  }


  /* Search input */

  .search-inp {
    border: none;
    outline: none;
    width: 100%;
    height: 100%;
    padding: 0 15px;
    font-size: 14px;
    background: transparent;
  }


  .search-inp::placeholder {
    color: #777;
  }


  /* ============================= */
  /* SEARCH BUTTON */
  /* ============================= */

  .search-btn {
    background-color: white;
    color: #222;
    border: 1px solid #ddd;
    height: 44px;
    padding: 0 18px;
    border-radius: 25px;
    font-size: 14px;

    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;

    transition: 0.25s ease-in-out;
    white-space: nowrap;
  }


  .search-btn:hover {
    background-color: #ff385c;
    color: white;
    border-color: #ff385c;
  }


  .search-btn i {
    font-size: 14px;
  }


  /* ============================= */
  /* FILTER BUTTON */
  /* ============================= */

  .filter-btn {
    background-color: white;
    color: #222;
    border: 1px solid #ddd;
    height: 44px;
    padding: 0 18px;
    border-radius: 25px;
    font-size: 14px;

    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;

    transition: 0.25s ease-in-out;
    white-space: nowrap;
  }


  .filter-btn:hover {
    background-color: #ff385c;
    color: white;
    border-color: #ff385c;
  }


  .filter-btn i {
    font-size: 14px;
  }


  /* ============================= */
  /* MOBILE DESIGN */
  /* ============================= */

  @media (max-width: 767px) {

    .navbar {
      min-height: 60px;
    }


    /* Logo */

    .navbar-brand {
      font-size: 24px;
      margin-right: 0;
    }


    /* Hamburger */

    .navbar-toggler {
      border: 1px solid #ddd;
      border-radius: 12px;
      padding: 7px 10px;
    }


    .navbar-toggler:focus {
      box-shadow: none;
    }


    /* Collapsed navbar */

    .navbar-collapse {
      padding: 15px 0;
    }


    /* Left + right navigation */

    .navbar-nav {
      width: 100%;
    }


    .navbar-nav .nav-link {
      padding: 12px 5px;
    }


    /* ============================= */
    /* MOBILE SEARCH */
    /* ============================= */

    .navbar-search-area {
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 10px;

      margin: 10px 0 !important;
    }


    .nav-search {
      width: 100% !important;
      height: 45px;
      margin: 0 !important;
    }


    .search-inp {
      width: 100% !important;
      min-width: 0 !important;
      font-size: 14px;
    }


    .search-btn,
    .filter-btn {
      width: 100%;
      height: 45px;
      margin: 0 !important;
    }

  }


  /* ============================= */
  /* VERY SMALL PHONES */
  /* ============================= */

  @media (max-width: 400px) {

    .navbar-search-area {
      padding: 0;
    }


    .search-btn,
    .filter-btn {
      font-size: 14px;
    }

  }

</style>


<!-- ========================================= -->
<!-- NAVBAR START -->
<!-- ========================================= -->

<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">

  <div class="container-fluid">


    <!-- ============================= -->
    <!-- WEBSITE LOGO -->
    <!-- ============================= -->

    <a class="navbar-brand" href="/listings">
      <i class="fa-solid fa-compass"></i>
    </a>


    <!-- ============================= -->
    <!-- MOBILE TOGGLE BUTTON -->
    <!-- ============================= -->

    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNavAltMarkup"
      aria-controls="navbarNavAltMarkup"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >

      <span class="navbar-toggler-icon"></span>

    </button>


    <!-- ============================= -->
    <!-- COLLAPSIBLE CONTENT -->
    <!-- ============================= -->

    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">


      <!-- ============================= -->
      <!-- LEFT NAVIGATION -->
      <!-- ============================= -->

      <div class="navbar-nav">

        <a class="nav-link" href="/listings">
          Explore
        </a>

      </div>


      <!-- ============================= -->
      <!-- SEARCH + FILTER AREA -->
      <!-- ============================= -->

      <div class="navbar-search-area">


        <!-- Search input -->

        <div class="nav-search">

          <input
            class="search-inp"
            type="search"
            placeholder="Search destinations"
            aria-label="Search destinations"
          >

        </div>


        <!-- Search button -->

        <button
          class="btn search-btn"
          type="button"
        >

          <i class="fa-solid fa-magnifying-glass"></i>

          <span>Search</span>

        </button>


        <!-- Filter button -->

        <button
          class="btn filter-btn"
          type="button"
        >

          <i class="fa-solid fa-sliders"></i>

          <span>Filters</span>

        </button>


      </div>


      <!-- ============================= -->
      <!-- RIGHT NAVIGATION -->
      <!-- ============================= -->

      <div class="navbar-nav ms-auto">


        <!-- Airbnb your home -->

        <a
          class="nav-link"
          href="/listings/new"
        >
          Airbnb your home
        </a>


        <!-- ============================= -->
        <!-- USER NOT LOGGED IN -->
        <!-- ============================= -->

        <% if (typeof currUser === "undefined" || !currUser) { %>

          <a
            class="nav-link"
            href="/signup"
          >
            <b>Sign up</b>
          </a>


          <a
            class="nav-link"
            href="/login"
          >
            <b>Log in</b>
          </a>

        <% } %>


        <!-- ============================= -->
        <!-- USER LOGGED IN -->
        <!-- ============================= -->

        <% if (typeof currUser !== "undefined" && currUser) { %>

          <a
            class="nav-link"
            href="/logout"
          >
            <b>Log out</b>
          </a>

        <% } %>


      </div>


    </div>

  </div>

</nav>

<!-- ========================================= -->
<!-- NAVBAR END -->
<!-- ========================================= -->