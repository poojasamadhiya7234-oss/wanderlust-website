<!-- ========================================= -->
<!-- CSS FOR SEARCH BAR AND FILTER BUTTON -->
<!-- ========================================= -->

<style>

.nav-search {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 25px;
  background: white;
  padding: 2px 8px;
  margin-left: 316px;
  border: 1px solid #ddd;
}

.search-inp {
  border: none;
  outline: none;
  width: 200px;
  padding: 4px 10px;
  font-size: 14px;
  border-radius: 20px;
}

.search-btn {
  margin-left: 10px;
  background-color: white;
  color: black;
  border: 1px solid #ddd;
  padding: 6px 14px;
  border-radius: 20px;
  font-size: 14px;
  display: flex;
  align-items: center;
  gap: 5px;
  transition: 0.25s ease-in-out;
}

.search-btn:hover {
  background-color: #ff5a5f;
  color: white;
  border-color: #ff5a5f;
}

.search-btn i {
  font-size: 14px;
}

.filter-btn {
  margin-left: 10px;
  background-color: white;
  color: black;
  border: 1px solid #ddd;
  padding: 6px 14px;
  border-radius: 20px;
  font-size: 14px;
  display: flex;
  align-items: center;
  gap: 6px;
  transition: 0.3s ease-in-out;
}

.filter-btn:hover {
  background-color: #ff5a5f;
  color: white;
  border-color: #ff5a5f;
}

.filter-btn i {
  font-size: 14px;
}


/* ========================================= */
/* MOBILE ONLY */
/* ========================================= */

@media (max-width: 767px) {

  .nav-search {
    width: 100% !important;
    margin-left: 0 !important;
    padding: 2px 8px;
  }

  .search-inp {
    width: 100% !important;
    min-width: 0 !important;
  }

  .navbar-collapse .d-flex {
    width: 100%;
    margin-left: 0 !important;
    margin-right: 0 !important;
    flex-wrap: wrap;
    gap: 8px;
  }

  .search-btn {
    margin-left: 0 !important;
  }

  .filter-btn {
    margin-left: 0 !important;
  }

}


/* ========================================= */
/* SMALL MOBILE */
/* ========================================= */

@media (max-width: 500px) {

  .navbar-collapse .d-flex {
    flex-direction: column;
    align-items: stretch !important;
  }

  .nav-search {
    width: 100% !important;
  }

  .search-btn,
  .filter-btn {
    width: 100%;
    justify-content: center;
  }

}

</style>


<!-- ========================================= -->
<!-- NAVBAR START -->
<!-- ========================================= -->

<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">

  <div class="container-fluid">

    <!-- WEBSITE LOGO -->

    <a class="navbar-brand" href="/listings">
      <i class="fa-solid fa-compass"></i>
    </a>


    <!-- MOBILE NAVBAR TOGGLE -->

    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNavAltMarkup"
      aria-controls="navbarNavAltMarkup"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>


    <!-- NAVBAR CONTENT -->

    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">


      <!-- LEFT SIDE -->

      <div class="navbar-nav">

        <a class="nav-link" href="/listings">
          Explore
        </a>

      </div>


      <!-- SEARCH + FILTER -->

      <div class="d-flex align-items-center mx-auto">

        <div class="nav-search">

          <input
            class="search-inp"
            type="search"
            placeholder="Search destinations"
          >

        </div>


        <button
          class="btn search-btn"
          type="button"
        >

          <i class="fa-solid fa-magnifying-glass"></i>

          Search

        </button>


        <button
          class="btn filter-btn"
          type="button"
        >

          <i class="fa-solid fa-sliders"></i>

          Filters

        </button>

      </div>


      <!-- RIGHT SIDE -->

      <div class="navbar-nav ms-auto">

        <a
          class="nav-link"
          href="/listings/new"
        >
          Airbnb your home
        </a>


        <% if (typeof currUser === "undefined" || !currUser) { %>

          <a
            class="nav-link"
            href="/signup"
          >
            <b>Sign up</b>
          </a>

          <a
            class="nav-link"
            href="/login"
          >
            <b>Log in</b>
          </a>

        <% } %>


        <% if (typeof currUser !== "undefined" && currUser) { %>

          <a
            class="nav-link"
            href="/logout"
          >
            <b>Log out</b>
          </a>

        <% } %>

      </div>

    </div>

  </div>

</nav>

<!-- ========================================= -->
<!-- NAVBAR END -->
<!-- ========================================= -->