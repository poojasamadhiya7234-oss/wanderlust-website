<!-- ========================================= -->
<!-- CSS FOR SEARCH BAR AND FILTER BUTTON -->
<!-- ========================================= -->

<style>

/* Main search input ka outer container */
.nav-search {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 25px;
  background: white;
  padding: 2px 8px;
  margin-left: 316px;
  border: 1px solid #ddd;
}


/* Search input field */
.search-inp {
  border: none;
  outline: none;
  width: 200px;
  padding: 4px 10px;
  font-size: 14px;
  border-radius: 20px;
}


/* Search button */
.search-btn {
  margin-left: 10px;
  background-color: white;
  color: black;
  border: 1px solid #ddd;
  padding: 6px 14px;
  border-radius: 20px;
  font-size: 14px;
  display: flex;
  align-items: center;
  gap: 5px;
  transition: 0.25s ease-in-out;
}


/* Search button hover */
.search-btn:hover {
  background-color: #ff5a5f;
  color: white;
  border-color: #ff5a5f;
}


/* Search icon size */
.search-btn i {
  font-size: 14px;
}


/* Filter button */
.filter-btn {
  margin-left: 10px;
  background-color: white;
  color: black;
  border: 1px solid #ddd;
  padding: 6px 14px;
  border-radius: 20px;
  font-size: 14px;
  display: flex;
  align-items: center;
  gap: 6px;
  transition: 0.3s ease-in-out;
}


/* Filter button hover */
.filter-btn:hover {
  background-color: #ff5a5f;
  color: white;
  border-color: #ff5a5f;
}


/* Filter icon size */
.filter-btn i {
  font-size: 14px;
}

</style>


<!-- ========================================= -->
<!-- NAVBAR START -->
<!-- ========================================= -->

<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">

  <!-- Bootstrap container -->
  <div class="container-fluid">


    <!-- WEBSITE LOGO -->
    <a class="navbar-brand" href="/listings">
      <i class="fa-solid fa-compass"></i>
    </a>


    <!-- MOBILE NAVBAR TOGGLE BUTTON -->
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNavAltMarkup"
    >
      <span class="navbar-toggler-icon"></span>
    </button>


    <!-- COLLAPSIBLE NAVBAR CONTENT -->
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">


      <!-- LEFT SIDE NAVIGATION -->
      <div class="navbar-nav">

        <!-- Explore page link -->
        <a class="nav-link" href="/listings">
          Explore
        </a>

      </div>


      <!-- SEARCH BAR + SEARCH BUTTON + FILTER BUTTON -->
      <div class="d-flex align-items-center mx-auto">


        <!-- Search input -->
        <div class="nav-search">

          <input
            class="search-inp"
            type="search"
            placeholder="Search destinations"
          >

        </div>


        <!-- Search button -->
        <button class="btn search-btn" type="submit">

          <i class="fa-solid fa-magnifying-glass"></i>

          Search

        </button>


        <!-- Filter button -->
        <button class="btn filter-btn">

          <i class="fa-solid fa-sliders"></i>

          Filters

        </button>

      </div>


      <!-- RIGHT SIDE NAVIGATION -->
      <div class="navbar-nav ms-auto">


        <!-- New listing link -->
        <a class="nav-link" href="/listings/new">
          Airbnb your home
        </a>


        <!-- Agar user login nahi hai -->
        <% if (typeof currUser === "undefined" || !currUser) { %>

          <a class="nav-link" href="/signup">
            <b>Sign up</b>
          </a>

          <a class="nav-link" href="/login">
            <b>Log in</b>
          </a>

        <% } %>


        <!-- Agar user login hai -->
        <% if (typeof currUser !== "undefined" && currUser) { %>

          <a class="nav-link" href="/logout">
            <b>Log out</b>
          </a>

        <% } %>


      </div>

    </div>

  </div>

</nav>

<!-- ========================================= -->
<!-- NAVBAR END -->
<!-- ========================================= -->

