<!-- ========================================= -->
<!-- NAVBAR CSS -->
<!-- ========================================= -->

<style>

  /* ============================= */
  /* MAIN NAVBAR */
  /* ============================= */

  .navbar {
    background-color: #ffffff !important;
    padding: 10px 20px;
  }

  .navbar-brand {
    color: #ff5a5f !important;
    font-size: 28px;
    margin-right: 25px;
  }


  /* ============================= */
  /* SEARCH AREA */
  /* ============================= */

  .navbar-search-area {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    flex: 1;
  }


  /* Search input outer box */

  .nav-search {
    display: flex;
    align-items: center;
    background: white;
    border: 1px solid #ddd;
    border-radius: 25px;
    height: 42px;
    width: 250px;
    margin: 0;
    padding: 0 12px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }


  /* Search input */

  .search-inp {
    width: 100%;
    border: none;
    outline: none;
    background: transparent;
    font-size: 14px;
    padding: 6px 8px;
  }


  /* ============================= */
  /* SEARCH BUTTON */
  /* ============================= */

  .search-btn {
    height: 42px;
    background-color: white;
    color: #222;
    border: 1px solid #ddd;
    padding: 0 18px;
    border-radius: 25px;
    font-size: 14px;

    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;

    transition: all 0.25s ease;
    white-space: nowrap;
  }


  .search-btn:hover {
    background-color: #ff5a5f;
    color: white;
    border-color: #ff5a5f;
  }


  .search-btn i {
    font-size: 14px;
  }


  /* ============================= */
  /* FILTER BUTTON */
  /* ============================= */

  .filter-btn {
    height: 42px;
    background-color: white;
    color: #222;
    border: 1px solid #ddd;
    padding: 0 18px;
    border-radius: 25px;
    font-size: 14px;

    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;

    transition: all 0.25s ease;
    white-space: nowrap;
  }


  .filter-btn:hover {
    background-color: #ff5a5f;
    color: white;
    border-color: #ff5a5f;
  }


  .filter-btn i {
    font-size: 14px;
  }


  /* ============================= */
  /* NAV LINKS */
  /* ============================= */

  .navbar .nav-link {
    color: #222 !important;
    font-size: 15px;
    margin: 0 5px;
    transition: 0.2s;
  }


  .navbar .nav-link:hover {
    color: #ff5a5f !important;
  }


  /* ============================= */
  /* MOBILE RESPONSIVE */
  /* ============================= */

  @media (max-width: 767px) {

    .navbar {
      padding: 10px 15px;
    }


    /* Logo */

    .navbar-brand {
      font-size: 25px;
    }


    /* Collapsed menu */

    .navbar-collapse {
      padding-top: 15px;
    }


    /* Search area */

    .navbar-search-area {
      width: 100%;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px;
      margin: 15px 0;
    }


    /* Search input */

    .nav-search {
      width: 100%;
      height: 45px;
      margin: 0 !important;
      flex: 1 1 100%;
    }


    .search-inp {
      width: 100%;
      font-size: 15px;
    }


    /* Buttons */

    .search-btn,
    .filter-btn {
      height: 44px;
      margin: 0 !important;
      flex: 1;
    }


    /* Left and right links */

    .navbar-nav {
      width: 100%;
    }


    .navbar-nav .nav-link {
      padding: 10px 5px;
    }


    /* Right side links */

    .navbar .ms-auto {
      margin-left: 0 !important;
      margin-top: 5px;
    }

  }


  /* ============================= */
  /* SMALL MOBILE SCREEN */
  /* ============================= */

  @media (max-width: 400px) {

    .navbar {
      padding-left: 10px;
      padding-right: 10px;
    }


    .search-btn,
    .filter-btn {
      font-size: 13px;
      padding: 0 10px;
    }

  }

</style>


<!-- ========================================= -->
<!-- NAVBAR START -->
<!-- ========================================= -->

<nav class="navbar navbar-expand-md border-bottom sticky-top">

  <div class="container-fluid">


    <!-- ============================= -->
    <!-- WEBSITE LOGO -->
    <!-- ============================= -->

    <a class="navbar-brand" href="/listings">
      <i class="fa-solid fa-compass"></i>
    </a>


    <!-- ============================= -->
    <!-- MOBILE MENU BUTTON -->
    <!-- ============================= -->

    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNavAltMarkup"
      aria-controls="navbarNavAltMarkup"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>


    <!-- ============================= -->
    <!-- COLLAPSIBLE NAVBAR -->
    <!-- ============================= -->

    <div
      class="collapse navbar-collapse"
      id="navbarNavAltMarkup"
    >


      <!-- ============================= -->
      <!-- LEFT NAVIGATION -->
      <!-- ============================= -->

      <div class="navbar-nav">

        <a class="nav-link" href="/listings">
          Explore
        </a>

      </div>


      <!-- ============================= -->
      <!-- SEARCH + FILTER -->
      <!-- ============================= -->

      <div class="navbar-search-area">


        <!-- Search input -->

        <div class="nav-search">

          <input
            class="search-inp"
            type="search"
            placeholder="Search destinations"
          >

        </div>


        <!-- Search button -->

        <button
          class="btn search-btn"
          type="button"
        >

          <i class="fa-solid fa-magnifying-glass"></i>

          Search

        </button>


        <!-- Filter button -->

        <button
          class="btn filter-btn"
          type="button"
        >

          <i class="fa-solid fa-sliders"></i>

          Filters

        </button>


      </div>


      <!-- ============================= -->
      <!-- RIGHT NAVIGATION -->
      <!-- ============================= -->

      <div class="navbar-nav ms-auto">


        <!-- Add new listing -->

        <a
          class="nav-link"
          href="/listings/new"
        >
          Airbnb your home
        </a>


        <!-- ============================= -->
        <!-- USER NOT LOGGED IN -->
        <!-- ============================= -->

        <% if (typeof currUser === "undefined" || !currUser) { %>


          <a
            class="nav-link"
            href="/signup"
          >
            <b>Sign up</b>
          </a>


          <a
            class="nav-link"
            href="/login"
          >
            <b>Log in</b>
          </a>


        <% } %>


        <!-- ============================= -->
        <!-- USER LOGGED IN -->
        <!--